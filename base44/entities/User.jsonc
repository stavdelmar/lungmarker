{
  "name": "User",
  "type": "object",
  "properties": {
    "initials": {
      "type": "string",
      "description": "e.g. DR"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "reviewer",
        "viewer"
      ],
      "default": "reviewer",
      "description": "Review period (Stav, 20 Oct): new users are reviewers by default; change per user in Settings → User roles"
    }
  }
}