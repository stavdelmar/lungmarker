{
  "name": "Nodule",
  "type": "object",
  "properties": {
    "scan": {
      "type": "string",
      "description": "Scan id"
    },
    "engine_scan_id": {
      "type": "string"
    },
    "nodule_label": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "AI",
        "Added by reviewer"
      ]
    },
    "engine_finding_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Accepted",
        "Rejected"
      ],
      "default": "Pending"
    },
    "reject_reason": {
      "type": "string"
    },
    "was_edited": {
      "type": "boolean",
      "default": false
    },
    "lobe": {
      "type": "string"
    },
    "slice_number": {
      "type": "number"
    },
    "key_slice_z": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "Solid",
        "Part-solid",
        "Ground-glass"
      ]
    },
    "long_axis_mm": {
      "type": "number"
    },
    "short_axis_mm": {
      "type": "number"
    },
    "mean_diameter_mm": {
      "type": "number"
    },
    "solid_component_mm": {
      "type": "number"
    },
    "volume_mm3": {
      "type": "number"
    },
    "kind": {
      "type": "string",
      "enum": ["nodule", "prior_not_found"],
      "default": "nodule",
      "description": "prior_not_found = a nodule from the prior scan that was not found on this follow-up; Daniel confirms it or says it is there"
    },
    "prior_label": {
      "type": "string",
      "description": "For prior_not_found: the prior scan's Nodule ID (e.g. N2)"
    },
    "contour_edits": {
      "type": "object",
      "description": "Outlines Daniel changed on slices other than the key slice: {\"<z>\": [[x,y],...]}; [] = erased on that slice"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this row was last exported to Excel by a reviewer"
    },
    "changed_after_export": {
      "type": "boolean",
      "default": false,
      "description": "True when the row changed after it was exported, so it goes into the next export again"
    },
    "volume_stale": {
      "type": "boolean",
      "default": false,
      "description": "True when the outline was edited by hand and the 3D volume has not been recomputed by the engine yet"
    },
    "outline_confirmed": {
      "type": "boolean",
      "default": false
    },
    "outline_confirmed_by_initials": {
      "type": "string"
    },
    "outline_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "match_to_prior": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_confidence": {
      "type": "number"
    },
    "key_contour_px": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "long_axis_px": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "short_axis_px": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "ai_draft": {
      "type": "object"
    }
  },
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "app_role": "reviewer"
          }
        },
        {
          "user_condition": {
            "data.app_role": "reviewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "app_role": "reviewer"
          }
        },
        {
          "user_condition": {
            "data.app_role": "reviewer"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}