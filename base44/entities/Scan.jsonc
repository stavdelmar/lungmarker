{
  "name": "Scan",
  "type": "object",
  "properties": {
    "engine_scan_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "scan_date": {
      "type": "string",
      "format": "date"
    },
    "timepoint": {
      "type": "string"
    },
    "series_number": {
      "type": "number"
    },
    "slice_thickness_mm": {
      "type": "number"
    },
    "n_slices": {
      "type": "number"
    },
    "prior_engine_scan_id": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "Not started",
        "In review",
        "Approved"
      ],
      "default": "Not started"
    },
    "active_seconds": {
      "type": "number",
      "default": 0
    },
    "minutes_on_scan": {
      "type": "number",
      "description": "Exported Minutes on scan = active minutes (since 17 Oct; before that it held the total). Read via src/lib/minutes.js"
    },
    "approved_by_email": {
      "type": "string"
    },
    "approved_by_initials": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine_version": {
      "type": "string"
    },
    "ai_findings_count": {
      "type": "number"
    },
    "total_seconds": {
      "type": "number",
      "default": 0,
      "description": "Time the scan was open in Review until approval (all sessions summed). Stops counting 5 min after the last input (mouse, keys, scroll) and resumes on the next input, so a scan left open doesn't inflate it. Same idea as Daniel's 'Minutes on scan'."
    },
    "active_minutes": {
      "type": "number",
      "description": "Active time at approval, rounded up (idle > idle_pause_seconds and hidden tab not counted). = exported Minutes on scan (Daniel, 17 Oct)"
    },
    "total_minutes": {
      "type": "number",
      "description": "Time the scan was open, opening to approval, rounded up. Shown on screen and in the Edit trail as 'open', not exported as Minutes on scan"
    },
    "resume_item_id": {
      "type": "string",
      "description": "Where 'Save & exit' left off: the selected nodule id (or 'central'); Continue reopens there."
    },
    "ai_fingerprint": {
      "type": "string",
      "description": "Fingerprint of the engine's findings.json when the AI draft was copied in (first opening). If the engine output changes later, Review warns and an admin can re-import."
    },
    "ai_imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_round": {
      "type": "number",
      "default": 0,
      "description": "Starts at 0; each reset for re-import adds 1. Edit-trail rows carry the round they were written in; the export uses the current round."
    },
    "reset_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last reset for re-import from the engine. The export uses only edit-trail rows from this time on (the trail itself is never deleted)."
    },
    "first_opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "central_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reviewer confirmed they checked the hilum / mediastinum (required before approval)"
    },
    "central_checked_by_initials": {
      "type": "string"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "engine_scan_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "app_role": "reviewer"
          }
        },
        {
          "user_condition": {
            "data.app_role": "reviewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "app_role": "reviewer"
          }
        },
        {
          "user_condition": {
            "data.app_role": "reviewer"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}